{
  "name": "dukaanflow",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "description": "Multi-tenant shop management platform",
  "workspaces": [
    "admin",
    "mobile",
    "server"
  ],
  "scripts": {
    "dev:admin": "npm run dev --workspace=admin",
    "dev:mobile": "npm run start --workspace=mobile",
    "dev:server": "npm run dev --workspace=server",
    "build:admin": "npm run build --workspace=admin",
    "build:server": "npm run build --workspace=server",
    "build": "npm run build:admin && npm run build:server",
    "typecheck:mobile": "npm exec --workspace=mobile -- tsc --noEmit",
    "typecheck:server": "npm run typecheck --workspace=server",
    "typecheck": "npm run typecheck:mobile && npm run typecheck:server",
    "lint:admin": "npm run lint --workspace=admin",
    "lint:mobile": "npm run lint --workspace=mobile",
    "lint": "npm run lint:admin && npm run lint:mobile",
    "test:server": "npm run test --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "db:generate": "npm run db:generate --workspace=server",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "verify": "npm run build && npm run typecheck && npm run lint && npm run test:server"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10.0.0"
  }
}
