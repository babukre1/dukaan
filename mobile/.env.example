# Default/recommended: deployed backend (works from Expo Go and APK builds).
EXPO_PUBLIC_API_URL=https://dukaanapi.abubakr.so/api/v1

# To test a backend running on your computer, copy this file to .env.local and
# replace the address below with your computer's LAN IPv4 address. The phone
# and computer must be on the same network. Never use localhost on a phone.
# EXPO_PUBLIC_API_URL=http://192.168.1.100:4000/api/v1
