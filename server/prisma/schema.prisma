generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  ADMIN
  OWNER
}

enum ShopAccountStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum MembershipRole {
  OWNER
}

enum SubscriptionType {
  TRIAL
  PAID
}

enum DurationUnit {
  DAY
  MONTH
  YEAR
}

enum SubscriptionRecordStatus {
  PENDING
  ACTIVE
  CANCELLED
}

enum SubscriptionEventType {
  ACTIVATED
  TRIAL_STARTED
  RENEWED
  EXTENDED
  CANCELLED
  CORRECTED
}

enum DebtEntryType {
  OPENING_BALANCE
  MANUAL_DEBT
  CREDIT_SALE
  REPAYMENT
  ADJUSTMENT
  REVERSAL
  SALE_RETURN
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  OTHER
}

enum StockMovementType {
  OPENING_STOCK
  STOCK_IN
  SALE
  SALE_RETURN
  ADJUSTMENT
  REVERSAL
}

enum SalePaymentStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
  VOIDED
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  fullName           String              @db.VarChar(120)
  phoneNumber        String              @unique @db.VarChar(20)
  passwordHash       String              @db.Text
  platformRole       PlatformRole
  isActive           Boolean             @default(true)
  mustChangePassword Boolean             @default(false)
  tokenVersion       Int                 @default(0)
  lastLoginAt        DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  memberships        ShopMembership[]
  refreshSessions    RefreshSession[]
  subscriptionEvents SubscriptionEvent[] @relation("SubscriptionActor")
  auditLogs          AdminAuditLog[]     @relation("AuditActor")
  debtEntries        DebtEntry[]         @relation("DebtEntryActor")
  payments           Payment[]           @relation("PaymentActor")
  stockMovements     StockMovement[]     @relation("StockMovementActor")
  sales              Sale[]              @relation("SaleCreator")
  voidedSales        Sale[]              @relation("SaleVoidActor")
  saleReturns        SaleReturn[]        @relation("SaleReturnActor")

  @@index([platformRole, isActive])
  @@map("users")
}

model Shop {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @db.VarChar(160)
  phoneNumber        String              @unique @db.VarChar(20)
  currencyCode       String              @default("USD") @db.Char(3)
  accountStatus      ShopAccountStatus   @default(ACTIVE)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  memberships        ShopMembership[]
  subscription       ShopSubscription?
  subscriptionEvents SubscriptionEvent[]
  auditLogs          AdminAuditLog[]
  customers          Customer[]
  debtEntries        DebtEntry[]
  payments           Payment[]
  categories         Category[]
  products           Product[]
  inventoryBalances  InventoryBalance[]
  stockMovements     StockMovement[]
  sales              Sale[]
  saleReturns        SaleReturn[]
  saleCounter        SaleCounter?

  @@index([accountStatus, createdAt])
  @@index([name])
  @@map("shops")
}

model ShopMembership {
  id        String         @id @default(uuid()) @db.Uuid
  shopId    String         @db.Uuid
  userId    String         @db.Uuid
  role      MembershipRole @default(OWNER)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  shop      Shop           @relation(fields: [shopId], references: [id], onDelete: Restrict)
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([shopId, userId])
  @@index([userId, isActive])
  @@index([shopId, isActive])
  @@map("shop_memberships")
}

model SubscriptionPlan {
  id            String             @id @default(uuid()) @db.Uuid
  code          String             @unique @db.VarChar(40)
  name          String             @db.VarChar(100)
  type          SubscriptionType
  durationUnit  DurationUnit
  durationCount Int
  price         Decimal            @default(0) @db.Decimal(18, 2)
  currencyCode  String             @default("USD") @db.Char(3)
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)
  subscriptions ShopSubscription[]

  @@index([isActive, type])
  @@map("subscription_plans")
}

model ShopSubscription {
  id               String                   @id @default(uuid()) @db.Uuid
  shopId           String                   @unique @db.Uuid
  planId           String                   @db.Uuid
  startsAt         DateTime                 @db.Timestamptz(3)
  expiresAt        DateTime                 @db.Timestamptz(3)
  status           SubscriptionRecordStatus @default(ACTIVE)
  snapshotPlanCode String                   @db.VarChar(40)
  snapshotPrice    Decimal                  @db.Decimal(18, 2)
  currencyCode     String                   @db.Char(3)
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @db.Timestamptz(3)
  shop             Shop                     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  plan             SubscriptionPlan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  events           SubscriptionEvent[]

  @@index([status, expiresAt])
  @@index([planId, status])
  @@map("shop_subscriptions")
}

model SubscriptionEvent {
  id                String                @id @default(uuid()) @db.Uuid
  shopId            String                @db.Uuid
  subscriptionId    String                @db.Uuid
  eventType          SubscriptionEventType
  previousExpiresAt DateTime?             @db.Timestamptz(3)
  newExpiresAt      DateTime?             @db.Timestamptz(3)
  performedByUserId String                @db.Uuid
  idempotencyKey    String?               @db.VarChar(120)
  note              String?               @db.VarChar(500)
  metadata          Json?
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  shop              Shop                  @relation(fields: [shopId], references: [id], onDelete: Restrict)
  subscription      ShopSubscription      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  performedBy       User                  @relation("SubscriptionActor", fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@unique([shopId, idempotencyKey])
  @@index([shopId, createdAt(sort: Desc)])
  @@index([subscriptionId, createdAt(sort: Desc)])
  @@map("subscription_events")
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  familyId   String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  replacedBy String?   @db.Uuid
  userAgent  String?   @db.VarChar(300)
  ipAddress  String?   @db.VarChar(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId, revokedAt])
  @@map("refresh_sessions")
}

model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @db.Uuid
  shopId      String?  @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @db.VarChar(80)
  entityId    String   @db.VarChar(80)
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  actor       User     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  shop        Shop?    @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@index([shopId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("admin_audit_logs")
}

model Customer {
  id                 String      @id @default(uuid()) @db.Uuid
  shopId             String      @db.Uuid
  fullName           String      @db.VarChar(150)
  phoneNumber        String?     @db.VarChar(20)
  address            String?     @db.VarChar(300)
  notes              String?     @db.VarChar(1000)
  outstandingBalance Decimal     @default(0) @db.Decimal(18, 2)
  archivedAt         DateTime?   @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(3)
  shop               Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  debtEntries        DebtEntry[]
  payments           Payment[]
  sales              Sale[]

  @@unique([id, shopId])
  @@unique([shopId, phoneNumber])
  @@index([shopId, createdAt(sort: Desc)])
  @@index([shopId, fullName])
  @@index([shopId, outstandingBalance])
  @@map("customers")
}

model DebtEntry {
  id              String        @id @default(uuid()) @db.Uuid
  shopId          String        @db.Uuid
  customerId      String        @db.Uuid
  paymentId       String?       @db.Uuid
  saleId          String?       @db.Uuid
  type            DebtEntryType
  amount          Decimal       @db.Decimal(18, 2)
  description     String?       @db.VarChar(500)
  reversalOfId    String?       @unique @db.Uuid
  idempotencyKey  String?       @db.VarChar(120)
  payloadHash     String?       @db.Char(64)
  createdByUserId String        @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  shop            Shop          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer        Customer      @relation(fields: [customerId, shopId], references: [id, shopId], onDelete: Restrict)
  payment         Payment?      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  sale            Sale?         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  reversalOf      DebtEntry?    @relation("DebtReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy      DebtEntry?    @relation("DebtReversal")
  createdBy       User          @relation("DebtEntryActor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([shopId, idempotencyKey])
  @@index([shopId, customerId, createdAt(sort: Desc)])
  @@index([shopId, saleId])
  @@map("debt_entries")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  shopId          String        @db.Uuid
  customerId      String?       @db.Uuid
  saleId          String?       @db.Uuid
  amount          Decimal       @db.Decimal(18, 2)
  method          PaymentMethod
  reference       String?       @db.VarChar(120)
  notes           String?       @db.VarChar(500)
  receivedAt      DateTime      @db.Timestamptz(3)
  reversedAt      DateTime?     @db.Timestamptz(3)
  reversalReason  String?       @db.VarChar(500)
  createdByUserId String        @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  shop            Shop          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer        Customer?     @relation(fields: [customerId, shopId], references: [id, shopId], onDelete: Restrict)
  sale            Sale?         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  createdBy       User          @relation("PaymentActor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  debtEntries     DebtEntry[]

  @@index([shopId, customerId, receivedAt(sort: Desc)])
  @@index([shopId, saleId])
  @@map("payments")
}

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  shopId     String    @db.Uuid
  name       String    @db.VarChar(100)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  products   Product[]

  @@unique([id, shopId])
  @@unique([shopId, name])
  @@index([shopId, archivedAt])
  @@map("categories")
}

model Product {
  id           String            @id @default(uuid()) @db.Uuid
  shopId       String            @db.Uuid
  categoryId   String?           @db.Uuid
  name         String            @db.VarChar(200)
  description  String?           @db.VarChar(500)
  unit         String            @db.VarChar(30)
  sellingPrice Decimal           @db.Decimal(18, 2)
  costPrice    Decimal?          @db.Decimal(18, 2)
  minimumStock Decimal           @default(0) @db.Decimal(18, 3)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  shop         Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  category     Category?         @relation(fields: [categoryId, shopId], references: [id, shopId], onDelete: Restrict)
  balance      InventoryBalance?
  movements    StockMovement[]
  saleItems    SaleItem[]

  @@unique([id, shopId])
  @@unique([shopId, name])
  @@index([shopId, categoryId])
  @@index([shopId, isActive])
  @@map("products")
}

model InventoryBalance {
  productId String   @id @db.Uuid
  shopId    String   @db.Uuid
  quantity  Decimal  @default(0) @db.Decimal(18, 3)
  version   Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  product   Product  @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Restrict)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@unique([productId, shopId])
  @@index([shopId, quantity])
  @@map("inventory_balances")
}

model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  shopId          String            @db.Uuid
  productId       String            @db.Uuid
  saleId          String?           @db.Uuid
  saleReturnId    String?           @db.Uuid
  type            StockMovementType
  quantityChange  Decimal           @db.Decimal(18, 3)
  quantityBefore  Decimal           @db.Decimal(18, 3)
  quantityAfter   Decimal           @db.Decimal(18, 3)
  unitCost        Decimal?          @db.Decimal(18, 2)
  reason          String?           @db.VarChar(50)
  note            String?           @db.VarChar(500)
  idempotencyKey  String?           @db.VarChar(120)
  payloadHash     String?           @db.Char(64)
  createdByUserId String            @db.Uuid
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  shop            Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product         Product           @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Restrict)
  sale            Sale?             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  saleReturn      SaleReturn?       @relation(fields: [saleReturnId], references: [id], onDelete: Restrict)
  createdBy       User              @relation("StockMovementActor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([shopId, idempotencyKey])
  @@index([shopId, productId, createdAt(sort: Desc)])
  @@index([shopId, saleId])
  @@index([shopId, saleReturnId])
  @@map("stock_movements")
}

model SaleCounter {
  shopId    String   @id @db.Uuid
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@map("sale_counters")
}

model Sale {
  id                 String            @id @default(uuid()) @db.Uuid
  shopId             String            @db.Uuid
  customerId         String?           @db.Uuid
  saleNumber         String            @db.VarChar(30)
  subtotal           Decimal           @db.Decimal(18, 2)
  discountAmount     Decimal           @default(0) @db.Decimal(18, 2)
  totalAmount        Decimal           @db.Decimal(18, 2)
  paidAmount         Decimal           @default(0) @db.Decimal(18, 2)
  paymentStatus      SalePaymentStatus
  paymentMethod      PaymentMethod?
  status             SaleStatus        @default(COMPLETED)
  notes              String?           @db.VarChar(500)
  idempotencyKey     String             @db.VarChar(120)
  payloadHash        String             @db.Char(64)
  createdByUserId    String             @db.Uuid
  voidedByUserId     String?            @db.Uuid
  voidedAt           DateTime?          @db.Timestamptz(3)
  voidReason         String?            @db.VarChar(500)
  voidIdempotencyKey String?            @db.VarChar(120)
  voidPayloadHash    String?            @db.Char(64)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  shop               Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer           Customer?          @relation(fields: [customerId, shopId], references: [id, shopId], onDelete: Restrict)
  createdBy          User               @relation("SaleCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  voidedBy           User?              @relation("SaleVoidActor", fields: [voidedByUserId], references: [id], onDelete: Restrict)
  items              SaleItem[]
  payments           Payment[]
  debtEntries        DebtEntry[]
  stockMovements     StockMovement[]
  returns            SaleReturn[]

  @@unique([id, shopId])
  @@unique([shopId, saleNumber])
  @@unique([shopId, idempotencyKey])
  @@unique([shopId, voidIdempotencyKey])
  @@index([shopId, createdAt(sort: Desc)])
  @@index([shopId, customerId, createdAt(sort: Desc)])
  @@map("sales")
}

model SaleItem {
  id                  String   @id @default(uuid()) @db.Uuid
  shopId              String   @db.Uuid
  saleId              String   @db.Uuid
  productId           String   @db.Uuid
  productNameSnapshot String   @db.VarChar(200)
  unitSnapshot        String   @db.VarChar(30)
  quantity            Decimal  @db.Decimal(18, 3)
  unitPrice           Decimal  @db.Decimal(18, 2)
  unitCostSnapshot    Decimal? @db.Decimal(18, 2)
  lineSubtotal        Decimal  @db.Decimal(18, 2)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  sale                Sale     @relation(fields: [saleId, shopId], references: [id, shopId], onDelete: Restrict)
  product             Product  @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Restrict)
  returnItems          SaleReturnItem[]

  @@unique([id, shopId])
  @@index([saleId])
  @@index([shopId, productId])
  @@map("sale_items")
}

model SaleReturn {
  id                  String        @id @default(uuid()) @db.Uuid
  shopId              String        @db.Uuid
  saleId              String        @db.Uuid
  returnNumber        Int
  totalAmount         Decimal       @db.Decimal(18, 2)
  debtReductionAmount Decimal       @default(0) @db.Decimal(18, 2)
  refundAmount        Decimal       @default(0) @db.Decimal(18, 2)
  refundMethod        PaymentMethod?
  reason              String?       @db.VarChar(500)
  idempotencyKey      String        @db.VarChar(120)
  payloadHash         String        @db.Char(64)
  createdByUserId     String        @db.Uuid
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  shop                Shop          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  sale                Sale          @relation(fields: [saleId, shopId], references: [id, shopId], onDelete: Restrict)
  createdBy           User          @relation("SaleReturnActor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items               SaleReturnItem[]
  stockMovements      StockMovement[]

  @@unique([id, shopId])
  @@unique([shopId, idempotencyKey])
  @@unique([saleId, returnNumber])
  @@index([shopId, saleId, createdAt(sort: Desc)])
  @@map("sale_returns")
}

model SaleReturnItem {
  id               String     @id @default(uuid()) @db.Uuid
  shopId           String     @db.Uuid
  saleReturnId     String     @db.Uuid
  saleItemId       String     @db.Uuid
  quantity         Decimal    @db.Decimal(18, 3)
  unitRefundAmount Decimal    @db.Decimal(18, 2)
  lineRefundAmount Decimal    @db.Decimal(18, 2)
  restock          Boolean    @default(true)
  saleReturn       SaleReturn @relation(fields: [saleReturnId, shopId], references: [id, shopId], onDelete: Restrict)
  saleItem         SaleItem   @relation(fields: [saleItemId, shopId], references: [id, shopId], onDelete: Restrict)

  @@index([saleReturnId])
  @@index([saleItemId])
  @@map("sale_return_items")
}
