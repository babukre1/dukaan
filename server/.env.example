NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:8081
# Runtime URL. Prefer Neon's pooled hostname (contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Recommended for Prisma migrations: the non-pooler Neon URL.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_NAME=Platform Admin
BOOTSTRAP_ADMIN_PHONE=+252610000000
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
