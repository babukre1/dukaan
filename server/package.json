{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/local-server.js",
  "engines": {
    "node": "22.x"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "argon2@0.44.0": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  },
  "scripts": {
    "dev": "tsx watch src/local-server.ts",
    "build": "tsc",
    "start": "node dist/local-server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "db:generate": "prisma7 generate",
    "db:migrate": "prisma7 migrate deploy",
    "db:migrate:deploy": "tsx prisma/migrate-deploy.ts",
    "db:migrate:dev": "prisma7 migrate dev",
    "db:status": "prisma7 migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma7 studio"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.44.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.12.29",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@prisma/prisma7": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
